<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="test_zone_map">
    <static>true</static>
    <allow_auto_disable>true</allow_auto_disable>

    <!-- ================================================================ -->
    <!-- 직선 하강형 점진적 확장 5-Zone 맵 (14m × 30m)                      -->
    <!-- 상단 좁은 복도(4m) → 점진 확장(6m→10m) → 대형 오픈(14m) → 회복(6m) -->
    <!-- LiDAR range_max=3.5m 절대 기준, Footprint 0.28×0.31m 기준          -->
    <!--                                                                    -->
    <!-- 경로: START(7,28) ↓ Z1 ↓ Z2 ↓ Z3(step1→step2) ↓ Z4(Open) ↓ Z5 ↓ GOAL -->
    <!-- ================================================================ -->

    <!-- ============================================================ -->
    <!--  벽체 1~20: 폐곡선 외곽 (시계 방향, 0.1m 모듈식 오버랩 보장)     -->
    <!-- ============================================================ -->

    <!-- 1. north_wall: Y=30, X: 5-9 (상단 복도 뚜껑) -->
    <link name="north_wall">
      <pose>7.0 30.0 1.0 0 0 0</pose>
      <collision name="collision"><geometry><box><size>4.2 0.2 2.0</size></box></geometry></collision>
      <visual name="visual">
        <geometry><box><size>4.2 0.2 2.0</size></box></geometry>
        <material>
          <ambient>0.4 0.45 0.5 1.0</ambient>
          <diffuse>0.6 0.65 0.7 1.0</diffuse>
          <script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script>
        </material>
      </visual>
    </link>

    <!-- 2. z12_east_wall: X=9, Y: 22-30 (Zone 1+2 동쪽 복도벽) -->
    <link name="z12_east_wall">
      <pose>9.0 26.0 1.0 0 0 0</pose>
      <collision name="collision"><geometry><box><size>0.2 8.2 2.0</size></box></geometry></collision>
      <visual name="visual">
        <geometry><box><size>0.2 8.2 2.0</size></box></geometry>
