<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="dynamic_obstacle">
    <static>false</static>
    <link name="base_link">
      <gravity>false</gravity>
      <pose>0 0 0.4 0 0 0</pose>
      <inertial>
        <mass>5.0</mass>
        <inertia>
          <ixx>0.3</ixx>
          <iyy>0.3</iyy>
          <izz>0.04</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>

      <!-- 2D LiDAR 센서 스캔 및 물리 충돌 판정용 Collision (반경 0.13m, 높이 0.8m) -->
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.13</radius>
            <length>0.8</length>
          </cylinder>
        </geometry>
        <surface>
          <contact>
            <collide_without_contact>true</collide_without_contact>
          </contact>
          <friction>
            <ode>
              <mu>0.0</mu>
              <mu2>0.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <!-- 시각화 Visual (빨간색 원기둥) -->
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.13</radius>
            <length>0.8</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.8 0.1 0.1 1.0</ambient>
          <diffuse>0.9 0.15 0.15 1.0</diffuse>
          <specular>0.2 0.2 0.2 1.0</specular>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Red</name>
          </script>
        </material>
      </visual>
    </link>

    <!-- 2D 평면 이동 플러그인 (ROS 2 cmd_vel 연동 - robot_namespace 지원) -->
    <plugin name="dynamic_obstacle_controller" filename="libgazebo_ros_planar_move.so">
      <ros>
        <remapping>cmd_vel:=cmd_vel</remapping>
        <remapping>odom:=odom</remapping>
      </ros>
      <update_rate>50</update_rate>
      <robot_base_frame>base_link</robot_base_frame>
      <odometry_frame>odom</odometry_frame>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>false</publish_odom_tf>
    </plugin>
  </model>
</sdf>
