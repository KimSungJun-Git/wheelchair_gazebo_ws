<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="localization_recovery_world">
    <!-- 태양광 조명 -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- 바닥 (Ground Plane) -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- 물리 엔진 설정 (ODE 최적화) -->
    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.4</sor>
          <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000.0</contact_max_correcting_vel>
          <contact_surface_layer>0.01</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- GUI 초기 카메라 조감도 시점 (24m x 23m 맵 중앙 상공에서 조감) -->
    <gui fullscreen="0">
      <camera name="overview_camera">
        <pose>12.0 10.0 36.0 0.0 1.25 1.5707</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <!-- 복원된 도면(gazebo_world_555.png) 기반 맵 모델 -->
    <model name="localization_recovery_map">
      <static>true</static>
      <allow_auto_disable>true</allow_auto_disable>

    <link name="north_wall_start">
      <pose>3.000 23.000 1.250 0 0 0</pose>
      <collision name="collision">
        <geometry>
          <box>
            <size>5.600 0.200 2.500</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <box>
            <size>5.600 0.200 2.500</size>
          </box>
        </geometry>
        <material>
          <ambient>0.4 0.45 0.5 1.0</ambient>
          <diffuse>0.6 0.65 0.7 1.0</diffuse>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name>
          </script>
        </material>
      </visual>
    </link>

