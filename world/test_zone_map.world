<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="test_zone_world">
    <!-- 태양광 조명 -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- 바닥 (Ground Plane) -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- 5-Zone 벤치마크 테스트 맵 모델 Include (U자형 2회 직각 꺾임 맵) -->
    <include>
      <uri>model://test_zone_map</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- 물리 엔진 설정 (ODE 최적화) -->
    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.4</sor>
          <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000.0</contact_max_correcting_vel>
          <contact_surface_layer>0.01</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- GUI 초기 카메라 조감도 시점 (14m x 30m 직선 하강형 맵 조감) -->
    <gui fullscreen="0">
      <camera name="overview_camera">
        <pose>7.0 -2.0 38.0 0.0 0.95 1.5707</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>
  </world>
</sdf>
